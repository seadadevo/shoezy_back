# Only build inputs enter the context. tsconfig.json also compiles tests/seeds.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!prisma.config.ts
!src/
!src/**
!prisma/
!prisma/**
!tests/
!tests/**

# Apply these after the allowlist, including to nested build-input directories.
**/.git
**/node_modules
**/dist
**/coverage
**/.next
**/.aws
**/.ssh
**/.codex
**/.agents
**/.npmrc
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/*.zip
**/*.sql
**/*.sql.gz
**/*.dump
**/*.backup
**/backups
**/exports
**/uploads
!prisma/migrations/**/migration.sql
!.env.example
!.env.coolify.example
