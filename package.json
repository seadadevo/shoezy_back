{
  "name": "shoe-store-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Modular MVC backend for a footwear e-commerce brand",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:demo:cleanup": "tsx prisma/cleanup-demo.ts",
    "notifications:retry": "tsx src/scripts/retry-notification-outbox.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "latest",
    "bcryptjs": "latest",
    "compression": "latest",
    "cookie-parser": "^1.4.7",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^11.0.2",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "morgan": "latest",
    "multer": "2.3.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "latest",
    "@types/morgan": "latest",
    "@types/multer": "2.0.0",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "latest",
    "eslint": "latest",
    "prisma": "latest",
    "socket.io-client": "^4.8.3",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "^8.67.0",
    "vitest": "latest"
  }
}
