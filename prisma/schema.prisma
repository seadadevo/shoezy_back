model HomepageBanner {
  id              String                  @id @default(uuid()) @db.Uuid
  placement       HomepageBannerPlacement @default(HERO_SLIDER)
  ctaUrl          String?                 @map("cta_url") @db.VarChar(500)
  desktopImageUrl String?                 @map("desktop_image_url") @db.VarChar(500)
  mobileImageUrl  String?                 @map("mobile_image_url") @db.VarChar(500)
  desktopVideoUrl             String? @map("desktop_video_url") @db.VarChar(500)
  desktopVideoMimeType        String? @map("desktop_video_mime_type") @db.VarChar(100)
  desktopVideoStorageProvider String? @map("desktop_video_storage_provider") @db.VarChar(40)
  desktopVideoStorageKey      String? @map("desktop_video_storage_key") @db.VarChar(255)
  mobileVideoUrl              String? @map("mobile_video_url") @db.VarChar(500)
  mobileVideoMimeType         String? @map("mobile_video_mime_type") @db.VarChar(100)
  mobileVideoStorageProvider  String? @map("mobile_video_storage_provider") @db.VarChar(40)
  mobileVideoStorageKey       String? @map("mobile_video_storage_key") @db.VarChar(255)
  sortOrder       Int                     @default(0) @map("sort_order")
  isActive        Boolean                 @default(true) @map("is_active")
  backgroundColor             String?                 @map("background_color") @db.VarChar(50)
  textColor                   String?                 @map("text_color") @db.VarChar(50)
  startsAt        DateTime?               @map("starts_at") @db.Timestamptz
  endsAt          DateTime?               @map("ends_at") @db.Timestamptz
  promotionId     String?                 @map("promotion_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  promotion    Discount?                   @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  translations HomepageBannerTranslation[]

  @@index([placement, isActive, sortOrder])
  @@index([promotionId])
  @@map("homepage_banners")
}

model HomepageBannerTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  bannerId    String  @map("banner_id") @db.Uuid
