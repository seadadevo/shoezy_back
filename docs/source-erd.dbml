Project ShoeBrandEcommerceNoGateway {
  database_type: 'PostgreSQL'
  Note: '''
  Production-ready ERD for a direct-to-consumer footwear brand.
  No online payment gateway is included.
  Payment is handled through cash on delivery, bank transfer, cash, or another manually verified method.
  Money values are stored in minor units.
  UUIDs are recommended for business entities.
  '''
}

/* =========================
   ENUMS
   ========================= */

Enum user_role {
 ADMIN
 CUSTOMER
 }

 Enum auth_provider {
  EMAIL
  GOOGLE
  FACEBOOK
}



Enum user_status {
  ACTIVE
  INACTIVE
}

Enum product_status {
  DRAFT
  ACTIVE
}

Enum cart_status {
  ACTIVE
  ORDERED
}

Enum order_status {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

Enum payment_status {
  PENDING
  PAID
  CANCELLED
}
Enum return_status {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED_AND_REFUNDED 
}

Enum media_type {
  IMAGE
  VIDEO
}

Enum review_status {
  PENDING
  APPROVED
  REJECTED
}

Enum banner_position {
  HERO_SLIDER
  SIDE_AD
  MIDDLE_BANNER
}

Enum variant_status { 
  ACTIVE 
  INACTIVE 
 }

/* =========================
   USERS / ACCESS CONTROL
   ========================= */

Table users {
  id uuid [pk]
  email varchar(320) [not null, unique]
  phone varchar(32) [unique]
  password_hash varchar(255)
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  status user_status [not null, default: 'ACTIVE']
  role user_role [not null, default: 'CUSTOMER', note: 'LEGACY COMPATIBILITY FIELD - NOT AUTHORIZATION AUTHORITY']
  provider auth_provider [not null, default: 'EMAIL']
  provider_id varchar(255)
  email_verified_at timestamptz
  phone_verified_at timestamptz
  last_login_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  Indexes {
    (status)
    (role)
    (provider_id)
    (provider, provider_id) [unique]
    (created_at)
  }
}


Table addresses {
  id uuid [pk]
  user_id uuid [not null]
  type address_type [not null, default: 'BOTH']
  label varchar(100)
  recipient_name varchar(200) [not null]
  phone varchar(32) [not null]
  country_code char(2) [not null]
  state varchar(120)
  city varchar(120) [not null]
  area varchar(120)
  postal_code varchar(32)
  line1 varchar(255) [not null]
  line2 varchar(255)
  latitude decimal(10,7)
  longitude decimal(10,7)
  is_default boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (user_id)
    (country_code, city)
  }
}

/* =========================
   PRODUCT CATALOG
   ========================= */

Table brands {
  id uuid [pk]
  name varchar(150) [not null]
  slug varchar(180) [not null, unique]
  description text
  logo_url varchar(500)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table categories {
  id uuid [pk]
  parent_id uuid
  name varchar(150) [not null]
  slug varchar(180) [not null, unique]
  description text
  image_url varchar(500)
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (parent_id)
    (is_active, sort_order)
  }
}

Table size_guides {
  id uuid [pk]
  name varchar(150) [not null]
  gender varchar(50)
  brand_id uuid
  notes text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table size_guide_entries {
  id uuid [pk]
  size_guide_id uuid [not null]
  eu_size varchar(20)
  us_size varchar(20)
  uk_size varchar(20)
  foot_length_cm decimal(5,2)
  sort_order int [not null, default: 0]

  Indexes {
    (size_guide_id, sort_order)
  }
}

Table products {
  id uuid [pk]
  brand_id uuid [not null]
  size_guide_id uuid
  name varchar(220) [not null]
  slug varchar(250) [not null, unique]
  sku_prefix varchar(80)
  short_description varchar(500)
  base_price decimal(10,2) [not null, default: 0.00]
  compare_at_price decimal(10,2)
  description text
  material varchar(150)
  gender varchar(50)
  season varchar(50)
  status product_status [not null, default: 'DRAFT']
  seo_title varchar(255)
  seo_description varchar(500)
  published_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  Indexes {
    (brand_id, status)
    (published_at)
  }
}

Table product_categories {
  product_id uuid [not null]
  category_id uuid [not null]
  is_primary boolean [not null, default: false]

  Indexes {
    (product_id, category_id) [pk]
    (category_id, product_id)
  }
}

Table product_options {
  id uuid [pk]
  product_id uuid [not null]
  name varchar(80) [not null, note: 'Examples: Size, Color']
  position int [not null, default: 0]

  Indexes {
    (product_id, name) [unique]
  }
}

Table product_option_values {
  id uuid [pk]
  option_id uuid [not null]
  value varchar(100) [not null]
  display_value varchar(100)
  color_hex varchar(7)
  metadata_json jsonb
  position int [not null, default: 0]

  Indexes {
    (option_id, value) [unique]
  }
}

Table product_variants {
  id uuid [pk]
  product_id uuid [not null]
  sku varchar(100) [not null, unique]
  barcode varchar(100) [unique]
  title varchar(220) [not null]
  is_active boolean [not null, default: true]
  stock_quantity int [not null, default: 0]
  weight_grams int
  price_minor bigint [not null, default: 0]
  cost_minor bigint 
  compare_at_price_minor bigint
  metadata_json jsonb
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  Indexes {
    (product_id, is_active)
  }
}

Table variant_option_values {
  variant_id uuid [not null]
  option_value_id uuid [not null]

  Indexes {
    (variant_id, option_value_id) [pk]
    (option_value_id, variant_id)
  }
}

Table product_media {
  id uuid [pk]
  product_id uuid [not null]
  variant_id uuid
  type media_type [not null]
  url varchar(500) [not null]
  alt_text varchar(255)
  position int [not null, default: 0]
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null]

  Indexes {
    (product_id, position)
    (variant_id)
    (product_id) [unique, note: 'Partial: WHERE is_primary = true']
  }
}

Table collections {
  id uuid [pk]
  name varchar(150) [not null]
  slug varchar(180) [not null, unique]
  description text
  image_url varchar(500)
  is_active boolean [not null, default: true]
  starts_at timestamptz
  ends_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'CHECK: ends_at IS NULL OR starts_at IS NULL OR ends_at > starts_at'
}

Table collection_products {
  collection_id uuid [not null]
  product_id uuid [not null]
  position int [not null, default: 0]

  Indexes {
    (collection_id, product_id) [pk]
  }
}

/* =========================
   ENUMS (For Discounts)
   ========================= */
Enum discount_type {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

Enum discount_scope {
  ORDER
  PRODUCT
  CATEGORY
}

/* =========================
   DISCOUNTS & PROMO CODES
   ========================= */

Table discounts {
  id uuid [pk]
  name varchar(150) [not null]
  code varchar(80) [unique]
  type discount_type [not null]
  scope discount_scope [not null, default: 'ORDER']
  priority int [not null, unique, note: 'Lower number has higher precedence; CHECK priority >= 0']
  value bigint [not null]
  currency char(3)
  min_order_minor bigint
  max_discount_minor bigint
  usage_limit int
  per_customer_limit int
  starts_at timestamptz [not null]
  ends_at timestamptz
  is_active boolean [not null, default: true]
  combinable boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table discount_targets {
  id uuid [pk]
  discount_id uuid [not null]
  product_id uuid
  category_id uuid

  Indexes {
    (discount_id)
    (discount_id, product_id) [unique, note: 'Partial: WHERE product_id IS NOT NULL']
    (discount_id, category_id) [unique, note: 'Partial: WHERE category_id IS NOT NULL']
  }

  Note: 'CHECK: exactly one of product_id and category_id is non-null'
}

Table discount_redemptions {
  id uuid [pk]
  discount_id uuid [not null]
  user_id uuid [not null]
  order_id uuid [not null]
  amount_minor bigint [not null]
  redeemed_at timestamptz [not null]

  Indexes {
    (discount_id, user_id)
    (order_id)
    (discount_id, order_id) [unique]
  }
}

/* =========================
   CART
   ========================= */

Table carts {
  id uuid [pk]
  user_id uuid
  session_token varchar(180) [unique]
  status cart_status [not null, default: 'ACTIVE']
  currency char(3) [not null, default: 'TND']
  discount_code varchar(80)
  expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (user_id, status)
    (session_token)
    (user_id) [unique, note: 'Partial: WHERE user_id IS NOT NULL AND status = ACTIVE']
  }
}

Table cart_items {
  id uuid [pk]
  cart_id uuid [not null]
  variant_id uuid [not null]
  quantity int [not null]
  unit_price_minor bigint [not null]
  discount_minor bigint [not null, default: 0]
  added_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (cart_id, variant_id) [unique]
  }
}

/* =========================
   ORDERS
   ========================= */

Table orders {
  id uuid [pk]
  order_number varchar(40) [not null, unique]
  idempotency_key varchar(128) [unique]
  user_id uuid
  cart_id uuid
  status order_status [not null, default: 'PENDING']
  payment_method varchar(50) [not null, default: 'COD']
  payment_status payment_status [not null, default: 'PENDING']
  currency char(3) [not null, default: 'TND']
  customer_email varchar(320) [not null]
  customer_phone varchar(32) [not null]
  subtotal_minor bigint [not null]
  discount_minor bigint [not null, default: 0]
  shipping_minor bigint [not null, default: 0]
  total_minor bigint [not null]
  paid_minor bigint [not null, default: 0]
  refunded_minor bigint [not null, default: 0]
  paid_at timestamptz
  notes text
  tracking_number varchar(150)
  shipping_provider varchar(100)
  placed_at timestamptz
  confirmed_at timestamptz
  cancelled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version int [not null, default: 0]

  Indexes {
    (user_id, created_at)
    (status, created_at)
    (payment_status, created_at)
    (customer_email)
  }
}

Table order_addresses {
  id uuid [pk]
  order_id uuid [not null]
  recipient_name varchar(200) [not null]
  phone varchar(32) [not null]
  country_code char(2) [not null, default: 'TN']
  state varchar(120)
  city varchar(120) [not null]
  area varchar(120)
  line1 varchar(255) [not null]
  line2 varchar(255)
  latitude decimal(10,7)
  longitude decimal(10,7)

  Indexes {
    (order_id) [unique]
  }
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null]
  product_id uuid [not null]
  variant_id uuid [not null]
  product_name varchar(220) [not null]
  variant_name varchar(220) [not null]
  sku varchar(100) [not null]
  quantity int [not null]
  unit_price_minor bigint [not null]
  discount_minor bigint [not null, default: 0]
  line_total_minor bigint [not null]
  unit_cost_minor bigint [not null, default: 0]
  snapshot_json jsonb [not null]

  Indexes {
    (order_id)
    (variant_id)
  }
}

Table order_status_history {
  id uuid [pk]
  order_id uuid [not null]
  from_status order_status
  to_status order_status [not null]
  reason varchar(255)
  changed_by_user_id uuid
  created_at timestamptz [not null]

  Indexes {
    (order_id, created_at)
  }
}

/* =========================
   SHIPPING
   ========================= */

Table shipping_methods {
  id uuid [pk]
  code varchar(80) [not null, unique]
  name varchar(150) [not null]
  base_price_minor bigint [not null]
  currency char(3) [not null, default: 'TND']
  estimated_min_days int
  estimated_max_days int
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}
/* =========================
   RETURNS / MANUAL REFUNDS
   ========================= */

Table return_requests {
  id uuid [pk]
  return_number varchar(50) [not null, unique]
  order_id uuid [not null]
  user_id uuid
  status return_status [not null, default: 'REQUESTED']
  reason_code varchar(80) [not null]
  reason_details text
  refund_method varchar(100)
  refund_amount_minor bigint [not null, default: 0]
  refund_proof_url varchar(500)
  requested_at timestamptz [not null]
  closed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (order_id)
    (user_id)
  }
}

Table return_items {
  id uuid [pk]
  return_request_id uuid [not null]
  order_item_id uuid [not null]
  quantity int [not null]
  reason_code varchar(80)
  restockable boolean [default: true]

  Indexes {
    (return_request_id, order_item_id) [unique]
  }
}


/* =========================
   CUSTOMER EXPERIENCE
   ========================= */

Table wishlists {
  id uuid [pk]
  user_id uuid [not null]
  product_id uuid [not null]
  variant_id uuid
  added_at timestamptz [not null]

  Indexes {
    (user_id, product_id, variant_id) [unique]
  }
}

Table product_reviews {
  id uuid [pk]
  product_id uuid [not null]
  user_id uuid [not null]
  order_item_id uuid
  rating int [not null]
  title varchar(180)
  body text
  status review_status [not null, default: 'PENDING']
  is_verified_purchase boolean [not null, default: false]
  published_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (product_id, status, created_at)
    (user_id, product_id)
    (order_item_id) [unique]
  }
}


/* =========================
   RELATIONSHIPS
   ========================= */
Ref: addresses.user_id > users.id

// Product Catalog
Ref: categories.parent_id > categories.id
Ref: size_guide_entries.size_guide_id > size_guides.id
Ref: size_guides.brand_id > brands.id
Ref: products.brand_id > brands.id
Ref: products.size_guide_id > size_guides.id
Ref: product_categories.product_id > products.id
Ref: product_categories.category_id > categories.id
Ref: product_options.product_id > products.id
Ref: product_option_values.option_id > product_options.id
Ref: product_variants.product_id > products.id
Ref: variant_option_values.variant_id > product_variants.id
Ref: variant_option_values.option_value_id > product_option_values.id
Ref: product_media.product_id > products.id
Ref: product_media.variant_id > product_variants.id
Ref: collection_products.collection_id > collections.id
Ref: collection_products.product_id > products.id

// Discounts
Ref: discount_targets.discount_id > discounts.id
Ref: discount_targets.product_id > products.id
Ref: discount_targets.category_id > categories.id
Ref: discount_redemptions.discount_id > discounts.id
Ref: discount_redemptions.user_id > users.id
Ref: discount_redemptions.order_id > orders.id

// Cart
Ref: carts.user_id > users.id
Ref: cart_items.cart_id > carts.id
Ref: cart_items.variant_id > product_variants.id

// Orders
Ref: orders.user_id > users.id
Ref: orders.cart_id > carts.id
Ref: order_addresses.order_id > orders.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: order_items.variant_id > product_variants.id
Ref: order_status_history.order_id > orders.id
Ref: order_status_history.changed_by_user_id > users.id

// Returns
Ref: return_requests.order_id > orders.id
Ref: return_requests.user_id > users.id
Ref: return_items.return_request_id > return_requests.id
Ref: return_items.order_item_id > order_items.id

// Customer Experience
Ref: wishlists.user_id > users.id
Ref: wishlists.product_id > products.id
Ref: wishlists.variant_id > product_variants.id
Ref: product_reviews.product_id > products.id
Ref: product_reviews.user_id > users.id
Ref: product_reviews.order_item_id > order_items.id

/* =========================
   AUTHENTICATION MODULE
   ========================= */

Table auth_sessions {
  id uuid [pk]
  user_id uuid [not null]
  refresh_token_hash varchar(255) [not null, unique]
  rotation_counter int [not null, default: 0]
  user_agent text
  ip_address varchar(45)
  expires_at timestamptz [not null]
  last_used_at timestamptz
  revoked_at timestamptz
  revoke_reason varchar(255)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Indexes {
    (user_id, revoked_at)
    (expires_at)
  }
}

Table password_reset_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (expires_at)
    (user_id, created_at)
  }
}

Table email_verification_tokens {
  id uuid [pk]
  user_id uuid [not null]
  email_snapshot varchar(320) [not null]
  token_hash varchar(255) [not null, unique]
  expires_at timestamptz [not null]
  used_at timestamptz
  revoked_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (expires_at)
    (user_id, created_at)
  }
}

Ref: auth_sessions.user_id > users.id
Ref: password_reset_tokens.user_id > users.id
Ref: email_verification_tokens.user_id > users.id

/* =========================
   RBAC MODULE
   ========================= */

Table roles {
  id uuid [pk]
  code varchar(80) [not null, unique]
  name varchar(120) [not null]
  description varchar(500)
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table permissions {
  id uuid [pk]
  code varchar(120) [not null, unique]
  description varchar(500)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table user_roles {
  user_id uuid [not null]
  role_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, role_id) [pk]
    (role_id)
  }
}

Table role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (role_id, permission_id) [pk]
    (permission_id)
  }
}

Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: role_permissions.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id
