# Safe reference only. Replace every placeholder before entering values in Coolify.
# All backend variables are runtime-only: disable Build Variable, enable Runtime Variable.
# REQUIRED: deployment selections (the Dockerfile supplies NODE_ENV and PORT defaults).
NODE_ENV=production
PORT=3000
# 1 only for one trusted Coolify proxy; review every network path before setting.
TRUST_PROXY_HOPS=1

# REQUIRED SECRET: use Coolify PostgreSQL's private URL, with encoded credentials.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_URL_ENCODED_PASSWORD@YOUR_PRIVATE_DB_HOST:5432/YOUR_DB_NAME
# REQUIRED SECRETS: distinct, random, >=32 characters. Preserve existing keys at cutover.
JWT_ACCESS_SECRET=replace_with_your_existing_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_your_existing_refresh_secret_at_least_32_chars

# REQUIRED in production (secure=true is enforced); domain-dependent SameSite.
AUTH_COOKIE_SECURE=true
# lax for https://shop.example.com + https://api.example.com.
# Change to none for a *.vercel.app frontend + api.example.com; see browser limits in guide.
AUTH_COOKIE_SAME_SITE=lax
FRONTEND_URL=https://shop.example.com
CORS_ORIGINS=https://shop.example.com

# REQUIRED in production: SMTP_HOST, MAIL_FROM, ORDER_NOTIFICATION_EMAIL.
SMTP_HOST=smtp.gmail.com
# Defaults are 587/false; Gmail implicit TLS uses 465/true.
SMTP_PORT=465
SMTP_SECURE=true
# Required pair for Gmail. SMTP_PASSWORD is a SECRET Gmail App Password.
SMTP_USER=YOUR_ACCOUNT@gmail.com
SMTP_PASSWORD=replace_with_your_gmail_app_password
MAIL_FROM=YOUR_ACCOUNT@gmail.com
# OPTIONAL display name (no default) and support recipient (falls back to order inbox).
MAIL_FROM_NAME=Shoozy
ORDER_NOTIFICATION_EMAIL=YOUR_ADMIN@example.com
SUPPORT_NOTIFICATION_EMAIL=YOUR_SUPPORT@example.com

# REQUIRED for this local-storage deployment. Driver defaults to local.
UPLOAD_STORAGE_DRIVER=local
UPLOAD_LOCAL_PATH=/app/storage/uploads
UPLOAD_BASE_URL=https://api.example.com/uploads
# OPTIONAL Cloudinary alternative: change driver to cloudinary and supply all three.
# Omit the local path/base URL and local volume when Cloudinary is used exclusively.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RAILWAY_VOLUME_MOUNT_PATH= is legacy only; omit on Coolify.

# OPTIONAL: values below show current application defaults.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=shoe-store-api
JWT_AUDIENCE=shoe-store-client
BCRYPT_ROUNDS=12
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_VERIFICATION_TOKEN_EXPIRES_IN=24h
AUTH_RESET_TOKEN_EXPIRES_IN=30m
AUTH_REFRESH_COOKIE_NAME=shoe_refresh
LOW_STOCK_THRESHOLD=5

# OPTIONAL social login (no defaults). Facebook secret is a SECRET.
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# OPTIONAL one-time bootstrap, consumed by npm run seed ONLY; no runtime auto-seed.
# Set all four in a protected seed env file for a fresh DB, then remove them.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FIRST_NAME=
# BOOTSTRAP_ADMIN_LAST_NAME=
